# ── Ask My Docs — environment config ─────────────────────────────────────
# Copy this file to `.env` in the project root (same folder as app.py).
# NEVER commit a real .env or paste its contents anywhere (chat, issues,
# screenshots) — treat any key that leaves this file as compromised and
# rotate it immediately at the provider's console.
#
# NOTE: an earlier version of this file documented OPENROUTER_API_KEY and
# OpenRouter-style model slugs (openai/gpt-5-mini, etc.). app.py never
# actually reads OPENROUTER_API_KEY — it reads the variable names below.
# If your real .env still has the old names, the app silently falls back
# to offline TF-IDF mode with no error, which looks like "it's just not
# using the LLM" rather than a config mismatch. Update to the names below.

# ── Embeddings + Vision OCR ────────────────────────────────────────────
# Two independent choices — EMBED_BACKEND (for retrieval) and
# VISION_BACKEND (for OCR'ing uploaded images) — each set to "ollama" by
# default, meaning GEMINI_API_KEY below is fully OPTIONAL: leave it blank
# and the app runs entirely without Google's API, using your own machine
# instead. Set either backend to "gemini" only if you want that one
# specific piece to use Gemini (e.g. better OCR quality) while keeping
# the other local, or set both to "gemini" to go back to the original
# all-Gemini setup.

# ── Option A: local, via Ollama (default — no API key, no rate limit) ───
#   1. Install Ollama: https://ollama.com/download
#   2. ollama pull nomic-embed-text   (embeddings, 768-dim)
#   3. ollama pull llava              (vision OCR — or moondream/llama3.2-vision)
#   4. ollama serve   (or it may already be running as a background service)
EMBED_BACKEND=ollama
VISION_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava
# Local vision OCR is noticeably weaker than Gemini's at dense text /
# busy scans — check real output quality before relying on it.

# ── Option B: Google Gemini (set EMBED_BACKEND/VISION_BACKEND=gemini) ───
# Gemini's free tier has a real requests-per-minute quota — expect
# "HTTP 429 Too Many Requests" on large documents; that's the quota,
# not a bug. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-3.7-flash
# NOTE: switching EMBED_BACKEND between gemini <-> ollama AFTER you've
# already indexed documents requires clearing and re-uploading them —
# gemini-embedding-001 produces 3072-dim vectors, nomic-embed-text
# produces 768-dim vectors, and Qdrant locks in whichever dimension
# arrives first for a given collection.

# ── Chat / answer generation, reranking, query rewriting ─────────────────
# CHAT_BACKEND selects between the two, same pattern as EMBED_BACKEND/
# VISION_BACKEND above:
#
# "ollama" (default here) = a fully local chat model — no API key, no
# cost, nothing leaves your machine. BUT a locally-runnable model is
# meaningfully weaker than a frontier cloud model at grounded
# citation-following and staying strictly within the retrieved excerpts —
# expect looser instruction adherence and more hallucination, and slower
# responses without a real GPU.
#   ollama pull llama3.1     (8B, solid general default)
#   ollama pull qwen2.5      (good instruction-following for its size)
#   ollama pull mistral      (7B, fast, lighter weight)
#
# "xai" = xAI's Grok models via the cloud API (needs XAI_API_KEY below,
# costs per token, noticeably stronger citation discipline). Set
# CHAT_BACKEND=xai to use it.
CHAT_BACKEND=ollama
OLLAMA_CHAT_MODEL=llama3.1

# ── xAI (Grok) config — only used when CHAT_BACKEND=xai above ───────────
XAI_API_KEY=
XAI_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
# Alternatives (check https://docs.x.ai/developers/models for the
# current lineup before picking one):
#   XAI_MODEL=grok-4.5     (flagship, higher cost, best for hard questions)
#   XAI_MODEL=grok-4.20    (1M context, reasoning/non-reasoning variants)

# ── Retrieval tuning ──────────────────────────────────────────────────────
# Minimum score (on Reciprocal Rank Fusion's normalized scale, NOT a raw
# cosine similarity — see RRF_K below) before the app will answer at all;
# below this it says "I don't know" instead of guessing. Recalibrated
# from an earlier 0.30 raw-cosine-scale value, which is not comparable
# to RRF's scale.
EMBED_MIN_SCORE=0.55
# "hybrid" (default) = BM25 + embeddings combined via Reciprocal Rank
# Fusion. "hybrid-legacy" = the older weighted-average blend, kept only
# for A/B comparison against the RRF default. "embed" = embeddings alone.
RETRIEVAL_MODE=hybrid
# Only used by RETRIEVAL_MODE=hybrid-legacy. Weight on the embedding
# score in that weighted blend (0-1). Not used by the RRF default.
HYBRID_ALPHA=0.6
# Reciprocal Rank Fusion's smoothing constant. NOT the textbook default
# (60, calibrated for web-scale search with thousands of candidates) —
# tested directly for a document-sized corpus (a few hundred chunks):
# 60 made a genuine top match and a plausible false positive score
# nearly the same (~1.0 vs ~0.78); 10 spreads them to ~1.0 vs ~0.39-0.42,
# leaving real room for EMBED_MIN_SCORE to discriminate between them.
RRF_K=10
# Real BM25 (term-frequency saturation + document-length normalization)
# — not the plain TF-IDF this project started with. Standard defaults;
# rarely need changing.
BM25_K1=1.5
BM25_B=0.75
# How many chunks retrieval returns before token-budget trimming.
# Widened from an earlier default of 5 — a narrower window let a
# genuinely relevant section (especially one split across chunks) get
# crowded out of consideration entirely by competing sections.
TOP_K=8
# Token budget for chunk text sent to the LLM per question (not counting
# the system prompt or the question itself). Raised alongside TOP_K —
# otherwise the wider candidate pool just gets trimmed straight back
# down here, defeating the point of widening it.
MAX_CONTEXT_TOKENS=6000

# ── Reranking (second-pass relevance judgment) ────────────────────────────
# Off by default. When enabled, sends the top RERANK_TOP_N RRF candidates
# to the LLM (xAI) for a real relevance score (0-10) each, reordering by
# that score — the practical substitute for a cross-encoder (Cohere
# Rerank / BGE-Reranker) this project uses instead of adding a new paid
# API or a heavy local ML dependency. Also replaces the cruder
# keyword-overlap safety check with the LLM's actual relevance judgment
# when enabled.
RERANK_ENABLED=false
RERANK_TOP_N=8
RERANK_MIN_RELEVANCE=5

# ── Query rewriting ─────────────────────────────────────────────────────
# Off by default. When enabled, an LLM (xAI) call rewrites the question
# into a cleaner search query BEFORE retrieval (e.g. a rambling question
# becomes a few keyword-rich search terms). Only affects what's searched
# FOR — the original question is still what's shown to the user and what
# the final answer is actually generated from.
QUERY_REWRITE_ENABLED=false

# ── Vector DB backend ──────────────────────────────────────────────────────
# "memory" = original brute-force in-process store, zero setup (default).
# "qdrant" = real vector DB. You're using Qdrant Cloud, so this is on.
VECTOR_BACKEND=qdrant
# Your Qdrant Cloud cluster URL — from your cluster's dashboard at
# cloud.qdrant.io, looks like: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.REGION.PROVIDER.cloud.qdrant.io:6333
# (keep the :6333 port suffix)
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io:6333
# Your Qdrant Cloud API key — from the same cluster's "API Keys" tab.
QDRANT_API_KEY=your_qdrant_api_key_here
# Timeout (seconds) for requests to Qdrant. Raise this if you see timeout
# errors on a distant/cold cluster.
QDRANT_TIMEOUT=10
# How many ANN candidates Qdrant returns per query before hybrid search
# re-ranks within that pool (see qdrant_store.py). Higher = better
# recall for the hybrid blend, slightly larger Qdrant query.
QDRANT_CANDIDATE_POOL=30

# ── Security / ops ─────────────────────────────────────────────────────────
# Signs session cookies. If unset, app.py generates a random per-process
# key on startup (logged as a warning) — fine for local dev, but sessions
# won't survive a restart and won't work across multiple worker processes.
# Set this explicitly for any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# ── Trace logging (W5 Task Set C) ──────────────────────────────────────────
# Where every /ask call's durable, replayable trace record is appended
# (JSONL — one line per call). See trace_store.py.
TRACE_LOG_PATH=traces/traces.jsonl

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
# Leave this as-is for a normal local run — only reachable from your own
# machine. If you're running inside Docker instead of `python app.py`
# directly, this MUST be 0.0.0.0 (docker-compose.yml already sets this
# for you) — otherwise the container's port mapping silently doesn't
# work: it'll start with no errors, but nothing outside the container
# can ever reach it.
HOST=127.0.0.1
# Flask's debug mode (auto-reload + interactive debugger). Leave this
# false/unset outside local development — the interactive debugger can
# execute arbitrary code if ever exposed to the network.
APP_DEBUG=false