# ── Ask My Docs environment template ─────────────────────────────────────────
# Copy this file to `.env` and fill in your values before starting the app:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)

# REQUIRED for "embeddings + LLM" mode. Get a key at https://openrouter.ai/keys
# If left empty, the app runs in TF-IDF (offline) mode with no AI answers.
OPENROUTER_API_KEY=

# Optional. Used to sign browser session cookies. Change it in production.
# SECRET_KEY=

# Optional. LLM used to generate grounded answers (OpenRouter model id).
# LLM_MODEL=deepseek/deepseek-chat

# Optional. Embedding model used to turn chunks into vectors (OpenRouter id).
# EMBED_MODEL=openai/text-embedding-3-small

# Optional. Minimum cosine-similarity a retrieved chunk must score (0.0–1.0).
# EMBED_MIN_SCORE=0.30

# Optional. Port the server listens on (default 5000).
# PORT=5000

# Optional. Set to 1/true/yes to use Flask's debug reloader instead of waitress.
# APP_DEBUG=0
