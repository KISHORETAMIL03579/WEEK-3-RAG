OPENROUTER_API_KEY=YOUR_NEW_OPENROUTER_API_KEY

APP_DEBUG=true

VECTOR_BACKEND=qdrant

QDRANT_URL=YOUR_NEW_QDRANT_URL

QDRANT_API_KEY=YOUR_NEW_QDRANT_API_KEY





# ── Ask My Docs — environment config ─────────────────────────────────────
# Copy this file to `.env` in the project root (same folder as app.py).
# NEVER commit a real .env or paste its contents anywhere (chat, issues,
# screenshots) — treat any key that leaves this file as compromised and
# rotate it immediately at openrouter.ai.

# ── Required for embeddings + LLM-generated answers ──────────────────────
# Without this, the app still runs — it falls back to a fully offline
# BM25-only mode (keyword search + a length-adaptive stitched answer, no
# LLM call at all). Get a key at https://openrouter.ai
OPENROUTER_API_KEY=your_key_here

# ── Models (both are plain OpenRouter model slugs — swap freely) ─────────
LLM_MODEL=openai/gpt-5-mini
EMBED_MODEL=openai/text-embedding-3-small
# Alternatives confirmed working:
#   LLM_MODEL=openai/gpt-4o-mini        (cheaper, 128k context)
#   LLM_MODEL=deepseek/deepseek-chat    (app.py's built-in fallback if unset)
#   EMBED_MODEL=baai/bge-base-en-v1.5   (768-dim, solid general default)
#   EMBED_MODEL=baai/bge-m3             (1024-dim, multilingual/long-doc)
# NOTE: changing EMBED_MODEL requires re-indexing — old and new vectors
# live in incompatible vector spaces. Clear and re-upload after switching.

# ── Retrieval tuning ──────────────────────────────────────────────────────
# Minimum score (on Reciprocal Rank Fusion's normalized scale, NOT a raw
# cosine similarity — see RRF_K below) before the app will answer at all;
# below this it says "I don't know" instead of guessing. Recalibrated
# from an earlier 0.30 raw-cosine-scale value, which is not comparable
# to RRF's scale.
EMBED_MIN_SCORE=0.55
# "hybrid" (default) = BM25 + embeddings combined via Reciprocal Rank
# Fusion. "hybrid-legacy" = the older weighted-average blend, kept only
# for A/B comparison against the RRF default. "embed" = embeddings alone.
RETRIEVAL_MODE=hybrid
# Only used by RETRIEVAL_MODE=hybrid-legacy. Weight on the embedding
# score in that weighted blend (0-1). Not used by the RRF default.
HYBRID_ALPHA=0.6
# Reciprocal Rank Fusion's smoothing constant. NOT the textbook default
# (60, calibrated for web-scale search with thousands of candidates) —
# tested directly for a document-sized corpus (a few hundred chunks):
# 60 made a genuine top match and a plausible false positive score
# nearly the same (~1.0 vs ~0.78); 10 spreads them to ~1.0 vs ~0.39-0.42,
# leaving real room for EMBED_MIN_SCORE to discriminate between them.
RRF_K=10
# Real BM25 (term-frequency saturation + document-length normalization)
# — not the plain TF-IDF this project started with. Standard defaults;
# rarely need changing.
BM25_K1=1.5
BM25_B=0.75
# How many chunks retrieval returns before token-budget trimming.
# Widened from an earlier default of 5 — a narrower window let a
# genuinely relevant section (especially one split across chunks) get
# crowded out of consideration entirely by competing sections.
TOP_K=8
# Token budget for chunk text sent to the LLM per question (not counting
# the system prompt or the question itself). Raised alongside TOP_K —
# otherwise the wider candidate pool just gets trimmed straight back
# down here, defeating the point of widening it.
MAX_CONTEXT_TOKENS=6000

# ── Reranking (second-pass relevance judgment) ────────────────────────────
# Off by default. When enabled, sends the top RERANK_TOP_N RRF candidates
# to the LLM for a real relevance score (0-10) each, reordering by that
# score — the practical substitute for a cross-encoder (Cohere Rerank /
# BGE-Reranker) this project uses instead of adding a new paid API or a
# heavy local ML dependency. Also replaces the cruder keyword-overlap
# safety check with the LLM's actual relevance judgment when enabled.
RERANK_ENABLED=false
RERANK_TOP_N=8
RERANK_MIN_RELEVANCE=5

# ── Query rewriting ─────────────────────────────────────────────────────
# Off by default. When enabled, an LLM call rewrites the question into a
# cleaner search query BEFORE retrieval (e.g. a rambling question becomes
# a few keyword-rich search terms). Only affects what's searched FOR —
# the original question is still what's shown to the user and what the
# final answer is actually generated from.
QUERY_REWRITE_ENABLED=false

# ── Vector DB backend ──────────────────────────────────────────────────────
# "memory" = original brute-force in-process store, zero setup (default).
# "qdrant" = real vector DB. You're using Qdrant Cloud, so this is on.
VECTOR_BACKEND=qdrant
# Your Qdrant Cloud cluster URL — from your cluster's dashboard at
# cloud.qdrant.io, looks like: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.REGION.PROVIDER.cloud.qdrant.io:6333
# (keep the :6333 port suffix)
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io:6333
# Your Qdrant Cloud API key — from the same cluster's "API Keys" tab.
QDRANT_API_KEY=your_qdrant_api_key_here
# Timeout (seconds) for requests to Qdrant. Raise this if you see timeout
# errors on a distant/cold cluster.
QDRANT_TIMEOUT=10
# How many ANN candidates Qdrant returns per query before hybrid search
# re-ranks within that pool (see qdrant_store.py). Higher = better
# recall for the hybrid blend, slightly larger Qdrant query.
QDRANT_CANDIDATE_POOL=30

# ── Security / ops ─────────────────────────────────────────────────────────
# Signs session cookies. If unset, app.py generates a random per-process
# key on startup (logged as a warning) — fine for local dev, but sessions
# won't survive a restart and won't work across multiple worker processes.
# Set this explicitly for any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
# Leave this as-is for a normal local run — only reachable from your own
# machine. If you're running inside Docker instead of `python app.py`
# directly, this MUST be 0.0.0.0 (docker-compose.yml already sets this
# for you) — otherwise the container's port mapping silently doesn't
# work: it'll start with no errors, but nothing outside the container
# can ever reach it.
HOST=127.0.0.1
# Flask's debug mode (auto-reload + interactive debugger). Leave this
# false/unset outside local development — the interactive debugger can
# execute arbitrary code if ever exposed to the network.
APP_DEBUG=false



OPENROUTER_API_KEY=your_key_here
LLM_MODEL=openai/gpt-5-mini
EMBED_MODEL=openai/text-embedding-3-small
EMBED_MIN_SCORE=0.55
RETRIEVAL_MODE=hybrid
HYBRID_ALPHA=0.6
RRF_K=10
BM25_K1=1.5
BM25_B=0.75
TOP_K=8
MAX_CONTEXT_TOKENS=6000
RERANK_ENABLED=false
RERANK_TOP_N=8
RERANK_MIN_RELEVANCE=5
QUERY_REWRITE_ENABLED=false
VECTOR_BACKEND=qdrant
QDRANT_URL=https://your-cluster-id.your-region.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_TIMEOUT=10
QDRANT_CANDIDATE_POOL=30
SECRET_KEY=
LOG_LEVEL=INFO
PORT=5000
HOST=127.0.0.1
APP_DEBUG=false