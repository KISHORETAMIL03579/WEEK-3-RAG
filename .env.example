# ── Ask My Docs — Environment Configuration Template ───────────────────────
# Copy this file to `.env` in the project root (same folder as app.py).
# NEVER commit a real .env or expose credentials in logs, issues, or chats.

# ── Embeddings & Vision OCR ────────────────────────────────────────────────
# Independent backend choices for embeddings (retrieval) and vision OCR (images).
# Defaults to "ollama" (local execution). Set to "gemini" for Google Cloud APIs.

# ── Option A: Local via Ollama (Default — no cloud API key required) ───────
# Requirements:
#   ollama pull nomic-embed-text
#   ollama pull llava
#   ollama serve
EMBED_BACKEND=ollama
VISION_BACKEND=ollama
# Local host execution:
OLLAMA_URL=http://localhost:11434
# Docker:
# OLLAMA_URL=http://host.docker.internal:11434
# Local Ollama embedding model.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Local Ollama vision model used for image OCR.
OLLAMA_VISION_MODEL=llava

# ── Option B: Google Gemini (set EMBED_BACKEND/VISION_BACKEND=gemini) ───────
# Obtain an API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-3.7-flash

# ── Chat / Answer Generation, Reranking, Query Rewriting ───────────────────
# CHAT_BACKEND options:
#   "ollama" (default) = fully local chat model (e.g. llama3.1, qwen2.5, mistral)
#   "xai"              = xAI Grok models (requires XAI_API_KEY)
CHAT_BACKEND=ollama
OLLAMA_CHAT_MODEL=llama3.1

# ── xAI (Grok) Config — only used when CHAT_BACKEND=xai ────────────────────
XAI_API_KEY=
XAI_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

# ── Retrieval Tuning ───────────────────────────────────────────────────────
# Minimum score threshold on RRF normalized scale (0.0 to 1.0) before answering.
EMBED_MIN_SCORE=0.55

# Retrieval mode: "hybrid" (BM25 + embeddings via RRF), "hybrid-legacy", or "embed"
RETRIEVAL_MODE=hybrid

# Weight on embeddings in hybrid-legacy mode (0.0 - 1.0; unused by RRF).
HYBRID_ALPHA=0.6

# Reciprocal Rank Fusion smoothing constant.
# Tuned for the document-sized corpus used by this application.
RRF_K=10

# BM25 term-frequency saturation and length-normalization constants.
BM25_K1=1.5
BM25_B=0.75

# Number of candidate chunks retrieved before token budget capping.
TOP_K=8

# Maximum context token budget sent to the LLM per query.
MAX_CONTEXT_TOKENS=6000

# ── Chunking Strategy Defaults ─────────────────────────────────────────────
# Default strategy ("structured" or "fixed") and fixed chunk word count.
DEFAULT_CHUNK_MODE=structured
DEFAULT_CHUNK_SIZE=512

# ── Reranking (Second-Pass Relevance Judgment) ─────────────────────────────
# Off by default. Sends candidate chunks to LLM for 0-10 relevance scoring.
RERANK_ENABLED=false
RERANK_TOP_N=8
RERANK_MIN_RELEVANCE=5

# ── Query Rewriting ────────────────────────────────────────────────────────
# Off by default. Uses LLM to formulate an optimized search query.
QUERY_REWRITE_ENABLED=false

# ── Vector DB Backend ──────────────────────────────────────────────────────
# Options: "qdrant" (vector database) or "memory" (in-process fallback).
VECTOR_BACKEND=qdrant

# Qdrant cluster endpoint.
# Leave empty for local Docker Compose (defaults to http://qdrant:6333).
# For Qdrant Cloud, set this to your cluster URL.
QDRANT_URL=

# Qdrant Cloud API key.
# Required when connecting to a secured Qdrant Cloud cluster.
QDRANT_API_KEY=

# Request timeout in seconds.
QDRANT_TIMEOUT=10

# Candidate pool size retrieved from Qdrant prior to hybrid re-ranking.
QDRANT_CANDIDATE_POOL=30

# ── Trace Logging ──────────────────────────────────────────────────────────
# Destination JSONL path for durable, audited /ask trace records.
TRACE_LOG_PATH=traces/traces.jsonl

# ── Security / Ops ─────────────────────────────────────────────────────────
# Session cookie signing key (Starlette SessionMiddleware, itsdangerous-signed).
# Required for production deployments to preserve sessions across restarts.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Deployment mode. Set to "production" to make SECRET_KEY mandatory (the app
# refuses to boot with an ephemeral per-process key). ENV / FLASK_ENV are
# still honored as legacy aliases.
# APP_ENV=production

# Adds the Secure flag to the session cookie. Enable ONLY when TLS terminates
# in front of the app — browsers drop Secure cookies over plain HTTP, which
# breaks login rather than hardening it.
SESSION_COOKIE_SECURE=false

# Admin API authentication key.
# Required when accessing admin endpoints (e.g. GET /orphans?all=true or cross-session replay).
# Leave empty if admin endpoints are not being used.
ADMIN_API_KEY=

# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# Local development:
HOST=127.0.0.1

# Docker/container deployments should use:
# HOST=0.0.0.0

# Enables uvicorn's autoreloader + debug logging on `python app.py`.
# Keep false in production.
APP_DEBUG=false
